/backups/
/logs/
/job-tracker/data/cache/
/job-tracker/data/.run.lock
/job-tracker/data/imports/*-raw-*.json
/job-tracker/data/imports/*-page-*.json
/job-tracker/data/review-queue.json
/Latest Results.txt

# Editor preferences
.idea/
.vscode/
